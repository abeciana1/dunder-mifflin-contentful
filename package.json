{
  "name": "dunder-mifflin-contentful",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "contentful:types": "npm run contentful:types:models && npm run contentful:types:graphql",
    "contentful:types:models": "dotenv -e .env.local -- sh -c 'cf-content-types-generator -s \"$CONTENTFUL_SPACE_ID\" -t \"$CONTENTFUL_MANAGEMENT_TOKEN\" -e \"${CONTENTFUL_ENVIRONMENT:-master}\" -o src/lib/contentful/types -d -r -g'",
    "contentful:types:graphql": "dotenv -e .env.local -- graphql-codegen --config codegen.ts",
    "graphql:types": "npm run contentful:types:graphql"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "contentful": "^11.12.1",
    "graphql": "^16.13.2",
    "graphql-request": "^7.4.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.3.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/typed-document-node": "^6.1.8",
    "@graphql-codegen/typescript": "^5.0.10",
    "@graphql-codegen/typescript-operations": "^5.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cf-content-types-generator": "^3.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
